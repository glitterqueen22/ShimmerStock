# ── ShimmerStock Environment Variables ──────────────────────────────────
# Copy this file to .env and fill in real values.
# WARNING: .env contains real secrets — never commit it to version control.
#
# All variables are REQUIRED unless marked (optional).

# ── Shopify Integration ──────────────────────────────────────────────────
# Used for connecting to Shopify Admin API.
# Get CLIENT_ID and CLIENT_SECRET from your Shopify Partner Dashboard.
SHOPIFY_CLIENT_ID=your_shopify_client_id_here
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret_here

# Store domain (e.g. mystore.myshopify.com or custom domain)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Legacy API token (optional — only used as fallback when no OAuth credentials exist)
# SHOPIFY_API_TOKEN=your_shopify_api_token_here

# Sync mode: "readonly" (default) or "full"
SHOPIFY_READ_ONLY=true

# ── Encryption ──────────────────────────────────────────────────────────
# 64-character hex string (32 bytes) for AES-256-GCM token encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# REQUIRED — the server will not start without this.
ENCRYPTION_KEY=generate_a_64_character_hex_string_here

# ── Server ──────────────────────────────────────────────────────────────
# Public URL where ShimmerStock is hosted (used for OAuth redirects)
SHIMMERSTOCK_URL=https://shimmerstock.ctonew.app

# ── Initial Admin Seed (optional) ───────────────────────────────────────
# Only used on first database creation to seed the initial users.
# If not set, random secure passwords are generated and printed to console once.
# ADMIN_INITIAL_PASSWORD=your_secure_admin_password
# OWNER_INITIAL_PASSWORD=your_secure_owner_password
