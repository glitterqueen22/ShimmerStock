{
  "name": "shimmerstock",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cd client && npx vite build",
    "start": "bun run build && bun run start:server",
    "start:server": "bun run server/index.js",
    "dev": "bun run server/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tests.json",
    "check:safety": "node scripts/redact-secret-report.mjs --check && node scripts/check-gateway-bypass.mjs --check",
    "shopify:oauth:check": "node scripts/check-shopify-oauth-config.mjs",
    "seed": "bun run server/seed.js",
    "seed:reset": "bun run server/seed.js --reset"
  },
  "dependencies": {
    "bwip-js": "^4.11.2",
    "cors": "^2.8.6",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.1",
    "gsap": "^3.15.0",
    "html5-qrcode": "^2.3.8",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "axe-core": "^4.13.0",
    "playwright": "^1.62.1",
    "react-test-renderer": "19.2.8",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
